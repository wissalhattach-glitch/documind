# Copie ce fichier en ".env" (à la racine, à côté de docker-compose.yml) et remplace les valeurs.
# Le fichier ".env" ne doit JAMAIS être commité.

# Base PostgreSQL (lue par docker-compose.yml et par Spring Boot)
DB_USER=documind
DB_PASSWORD=change_me

# Clé secrète pour signer les tokens JWT (32 caractères minimum, aléatoire)
JWT_SECRET=change_me_with_a_long_random_string

# Clé API Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key